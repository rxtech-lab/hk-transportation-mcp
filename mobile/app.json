{
  "expo": {
    "name": "HKTransportAgent",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "1",
      "bundleIdentifier": "com.rxlab.hktransport",
      "icon": "./assets/images/ios-icon.png",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.rxlab.hktransport"
        ]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to find nearby bus stops and show real-time arrivals.",
        "NSPhotoLibraryUsageDescription": "HKTransportAgent does not read or upload your photos. This permission is only declared because an image component we use can display images stored on your device.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "versionCode": 1,
      "package": "com.rxlab.hktransport",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to find nearby bus stops and show real-time arrivals."
        }
      ],
      "expo-sqlite",
      "@bacons/apple-targets",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "We use the microphone so you can speak your question instead of typing it.",
          "speechRecognitionPermission": "Speech is transcribed on your device to turn what you say into text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbeec49c-a9e7-4478-b52e-bb9bfe11a565"
      }
    }
  }
}
