DATABASE_URL=postgres://localhost:5432/hk_transport?sslmode=disable
REDIS_URL=localhost:6379
PORT=8080

# OAuth (optional — authenticated users get higher rate limits)
OAUTH_SERVER_URL=
OAUTH_ISSUER=
OAUTH_AUDIENCE=

# Cache (set to false to disable Redis caching, default: true)
CACHE_ENABLED=true

# WhatsApp (WaSenderAPI) — optional, enables WhatsApp chatbot
WASENDER_API_KEY=
WASENDER_BASE_URL=https://api.wasenderapi.com

# AI Gateway (Vercel) — required when WhatsApp is enabled
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.6

# Upstash Redis — optional, enables frontend chat rate limiting (200 msgs/day/IP)
KV_REST_API_URL=
KV_REST_API_TOKEN=
