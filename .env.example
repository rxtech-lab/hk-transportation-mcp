DATABASE_URL=postgres://localhost:5432/hk_transport?sslmode=disable
REDIS_URL=localhost:6379
PORT=8080

# OAuth (optional — leave OAUTH_SERVER_URL empty to disable auth)
OAUTH_SERVER_URL=
OAUTH_ISSUER=
OAUTH_AUDIENCE=

# Cache (set to false to disable Redis caching, default: true)
CACHE_ENABLED=true
